<Window x:Class="PatchIt.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PatchIt.Client.ViewModels"
        xmlns:views="clr-namespace:PatchIt.Client.Views"
        xmlns:models="clr-namespace:PatchIt.Client.Models"
        Title="PatchIT — Libreria traduzioni"
        Width="1320" Height="860"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/PatchIT;component/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="13"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== Barra laterale: solo testo ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource LineSoftBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="26,30,20,0">
                    <TextBlock FontSize="15" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}">
                        <Run Text="PATCH"/><Run Text="IT" Foreground="{StaticResource AmberBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Libreria traduzioni" FontSize="10"
                               Foreground="{StaticResource MutedSoftBrush}" Margin="0,7,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,34,0,0">
                    <StackPanel Margin="26,0,22,18">

                        <TextBlock Text="NAVIGAZIONE" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <Button Style="{StaticResource SidebarNav}" Tag="library" AutomationProperties.Name="Libreria"
                                Command="{Binding NavigateCommand}" CommandParameter="library">
                            <TextBlock Text="Libreria" VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <Button Style="{StaticResource SidebarNav}" Tag="updates" AutomationProperties.Name="Aggiornamenti"
                                Command="{Binding NavigateCommand}" CommandParameter="updates">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Aggiornamenti" VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding UpdateCount}" FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.75"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarNav}" Tag="installed" AutomationProperties.Name="Scaricate"
                                Command="{Binding NavigateCommand}" CommandParameter="installed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scaricate" VerticalAlignment="Center" FontSize="13.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding InstalledCount}" FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           Opacity="0.75"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource SidebarNav}" Tag="settings" AutomationProperties.Name="Impostazioni"
                                Command="{Binding NavigateCommand}" CommandParameter="settings">
                            <TextBlock Text="Impostazioni" VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <Border Height="1" Margin="0,26,0,22" Background="{StaticResource LineSoftBrush}"/>

                        <TextBlock Text="FILTRI" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedSoftBrush}"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Filters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TextFilter}" AutomationProperties.Name="{Binding Label}"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Key}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="0,0,0,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="10.5"
                                                       VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="26,0,22,22">
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource BtnSmall}"
                                Content="{Binding AppUpdateButtonText}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip="Scarica l'aggiornamento, sostituisce l'exe e riavvia PatchIT"
                                AutomationProperties.Name="Aggiorna PatchIT"
                                Command="{Binding DownloadAppUpdateCommand}"
                                IsEnabled="{Binding CanDownloadAppUpdate}"/>
                        <DockPanel Margin="0,8,0,0"
                                   Visibility="{Binding IsAppUpdating, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Right" FontSize="10.5"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedSoftBrush}"
                                       Text="{Binding AppUpdateProgress, StringFormat={}{0:0}%}"/>
                            <ProgressBar Value="{Binding AppUpdateProgress, Mode=OneWay}"
                                         Maximum="100" Height="3" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10"
                               Foreground="{StaticResource MutedSoftBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Contenuto ==================== -->
        <Grid Grid.Column="1">

            <!-- ===== Libreria ===== -->
            <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource InvBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Intestazione -->
                <Border Grid.Row="0" Padding="40,36,32,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding LibraryTitle}"/>
                                <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,10,0,0">
                                    <Run Text="{Binding GameCount, Mode=OneWay}"/><Run Text=" traduzioni   ·   "/><Run Text="{Binding UpdateCount, Mode=OneWay}"/><Run Text=" da aggiornare   ·   "/><Run Text="{Binding InstalledCount, Mode=OneWay}"/><Run Text=" scaricate"/>
                                </TextBlock>
                                <TextBlock Text="{Binding CatalogNote}" FontSize="11"
                                           Foreground="{StaticResource AmberBrush}" Margin="0,10,0,0"
                                           Visibility="{Binding HasCatalogNote, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchLine}"
                                         Width="280" Height="34"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Style="{StaticResource TextLink}" Margin="14,0,0,0"
                                        AutomationProperties.Name="Cerca nel catalogo"
                                        Command="{Binding TogglePaletteCommand}">
                                    <TextBlock Text="Ctrl K" FontSize="10.5"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Ordina e conteggio -->
                        <DockPanel Margin="0,22,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedSoftBrush}" FontSize="11.5">
                                    <Run Text="{Binding GameCount, Mode=OneWay}"/><Run Text=" risultati"/>
                                </TextBlock>
                                <Button Style="{StaticResource BtnSmall}" Content="Aggiorna tutto"
                                        Margin="16,0,0,0" Padding="10,5" FontSize="11.5" VerticalAlignment="Center"
                                        AutomationProperties.Name="Aggiorna tutto"
                                        Command="{Binding UpdateAllCommand}"
                                        Visibility="{Binding CanUpdateAll, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ordina" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedSoftBrush}"
                                           Margin="0,0,12,0"/>
                                <ItemsControl ItemsSource="{Binding SortOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TextFilter}"
                                                    Margin="0,0,16,0" Padding="0,3"
                                                    AutomationProperties.Name="{Binding Label}"
                                                    Command="{Binding DataContext.SetSortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Key}">
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>

                        <!-- Coda "Aggiorna tutto" -->
                        <Border Margin="0,18,0,0" Padding="0,0,0,12"
                                BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1"
                                Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TextLink}"
                                            Content="Ferma" Margin="16,0,0,0" Padding="0,2"
                                            AutomationProperties.Name="Ferma aggiornamento"
                                            Command="{Binding CancelDownloadCommand}"/>
                                    <TextBlock Text="{Binding QueueMessage}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </DockPanel>
                                <ProgressBar Margin="0,9,0,0" Maximum="100"
                                             Value="{Binding QueueProgress, Mode=OneWay}"
                                             Foreground="{StaticResource AmberBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Height="1" Margin="0,22,0,0" Background="{StaticResource LineSoftBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Corpo -->
                <Grid Grid.Row="1">
                    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                                 Margin="40,0,32,0"
                                 Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"/>

                    <!-- Primo caricamento -->
                    <ItemsControl ItemsSource="{Binding SkeletonSlots}"
                                  Margin="40,24,32,26" VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  Visibility="{Binding IsFirstLoad, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SkeletonBlock}"
                                        Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CornerRadius="3" Margin="0,0,20,22"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Errore -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Riprova"
                                HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                    </StackPanel>

                    <!-- Griglia -->
                    <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                        <ListBox x:Name="GamesList"
                                 ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource GameCardArt}"
                                 ItemContainerStyle="{StaticResource GameTileArt}"
                                 Margin="40,24,32,26"
                                 Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"
                                 PreviewMouseRightButtonDown="GamesList_PreviewMouseRightButtonDown"
                                 KeyDown="GamesList_KeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource LineBrush}"
                                             Foreground="{StaticResource TextBrush}">
                                    <MenuItem IsEnabled="{Binding SelectedGame.CanInstallInGame, FallbackValue=False}"
                                              Command="{Binding InstallInGameCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Installa nel gioco"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem IsEnabled="{Binding SelectedGame.CanVerify, FallbackValue=False}"
                                              Command="{Binding VerifyFileCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Verifica integrità"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Command="{Binding RevealFileCommand}"
                                              CommandParameter="{Binding SelectedGame.LocalFilePath}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Apri cartella"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem IsEnabled="{Binding SelectedGame.IsDownloaded, FallbackValue=False}"
                                              Command="{Binding RemoveInstalledCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Elimina dal disco"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Nessun risultato -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyMessage}" Margin="0,6,0,0" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Azzera ricerca e filtri"
                                    HorizontalAlignment="Center" Margin="0,16,0,0"
                                    AutomationProperties.Name="Azzera ricerca e filtri"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding CanResetFilters, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Avviso in basso -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                            Padding="14,9" CornerRadius="8"
                            Background="{StaticResource SurfaceHiBrush}"
                            BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource TextLink}" Content="OK"
                                    Margin="14,0,0,0" Padding="0,2" VerticalAlignment="Center"
                                    Command="{Binding DismissStatusCommand}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap"
                                       MaxWidth="520" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Impostazioni ===== -->
            <views:SettingsView Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- ===== Scheda gioco a pagina intera ===== -->
            <Border Background="{StaticResource BgBrush}"
                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <views:GameDetail/>
            </Border>
        </Grid>

        <!-- ==================== Palette dei comandi ==================== -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}"
                    MouseLeftButtonUp="PaletteScrim_MouseLeftButtonUp"/>

            <Border Width="620" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270"
                                      Opacity="0.55" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <DockPanel Margin="18,14,18,14">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}" FontSize="16"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="4"
                                Background="{StaticResource SurfaceAltBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="ESC" FontSize="10"
                                       Foreground="{StaticResource MutedSoftBrush}"/>
                        </Border>
                        <TextBox x:Name="PaletteInput" Style="{StaticResource PaletteBox}"
                                 Margin="12,0,12,0" Height="30"
                                 Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="PaletteInput_KeyDown"/>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource LineSoftBrush}"/>

                    <ListBox x:Name="PaletteList"
                             ItemsSource="{Binding PaletteResults}"
                             SelectedItem="{Binding PaletteSelection, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PaletteItemStyle}"
                             MaxHeight="324" Margin="6,6,6,8"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseLeftButtonUp="PaletteList_MouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedSoftBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13.5"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                   Foreground="{StaticResource MutedSoftBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Height="1" Background="{StaticResource LineSoftBrush}"/>
                    <TextBlock Text="↑↓ scegli · ↵ apri · esc chiudi" FontSize="11"
                               Foreground="{StaticResource MutedSoftBrush}"
                               Margin="18,9,18,11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Conferma in-app ==================== -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}"
                    MouseLeftButtonUp="DialogScrim_MouseLeftButtonUp"/>

            <Border x:Name="DialogPanel" Width="540" MaxHeight="580"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="26,24,26,20"
                    IsVisibleChanged="DialogPanel_IsVisibleChanged">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270"
                                      Opacity="0.55" Color="#000000"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentDialog.Eyebrow}" FontSize="10"
                                   Foreground="{StaticResource MutedSoftBrush}"
                                   Visibility="{Binding CurrentDialog.HasEyebrow, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding CurrentDialog.Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" FontWeight="Light"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TextBlock Text="{Binding CurrentDialog.Message}" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>

                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding CurrentDialog.HasDetail, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeading}"
                                       Text="{Binding CurrentDialog.DetailLabel}"/>
                            <TextBlock Text="{Binding CurrentDialog.Detail}" FontSize="11.5"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource TealBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentDialog.Detail}"/>
                        </StackPanel>

                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding CurrentDialog.HasFiles, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,0,0,14"/>
                            <TextBlock Style="{StaticResource SectionHeading}"
                                       Text="{Binding CurrentDialog.FilesLabel}"/>
                            <ScrollViewer MaxHeight="164" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CurrentDialog.Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11.5"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{StaticResource BodyTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <TextBlock Text="{Binding CurrentDialog.Note}" FontSize="11"
                                   Foreground="{StaticResource MutedSoftBrush}" TextWrapping="Wrap"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding CurrentDialog.HasNote, Converter={StaticResource BoolToVis}}"/>

                        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,18,0,16"/>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="↵ conferma · esc annulla" FontSize="10.5"
                                       Foreground="{StaticResource MutedSoftBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnGhost}"
                                        Content="{Binding CurrentDialog.CancelText}"
                                        AutomationProperties.Name="Annulla"
                                        Command="{Binding CancelDialogCommand}"/>
                                <Button x:Name="DialogConfirmButton" Style="{StaticResource BtnPrimary}"
                                        Content="{Binding CurrentDialog.ConfirmText}"
                                        AutomationProperties.Name="{Binding CurrentDialog.ConfirmText}"
                                        Margin="10,0,0,0"
                                        Command="{Binding ConfirmDialogCommand}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Conferme delle azioni riuscite -->
        <ItemsControl Grid.ColumnSpan="2"
                      ItemsSource="{Binding Toasts}"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,22,22" MaxWidth="380"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="8"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SurfaceHiBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="2" CornerRadius="1"
                                    Margin="0,1,11,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource TealBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}"
                                                         Value="{x:Static models:ToastKind.Info}">
                                                <Setter Property="Background" Value="{StaticResource AmberBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                       MaxWidth="300" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
