<Window x:Class="PatchIt.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PatchIt.Client.ViewModels"
        xmlns:views="clr-namespace:PatchIt.Client.Views"
        Title="PatchIT — Libreria traduzioni"
        Width="1320" Height="860"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/PatchIT;component/Assets/app.ico"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- ==================== Shell ==================== -->
        <Grid x:Name="LibraryRoot">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="12" KernelType="Gaussian"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== Rail laterale ========== -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineSoftBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,24,22,20">
                        <Image Source="/PatchIT;component/Assets/logo.png"
                               Width="34" Height="34" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PatchIT" FontSize="19" FontWeight="SemiBold"
                                       FontFamily="{StaticResource DisplayFont}"/>
                            <TextBlock Text="Libreria traduzioni" FontSize="11.5"
                                       Foreground="{StaticResource MutedSoftBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav + filtri -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,16">

                            <TextBlock Text="NAVIGAZIONE" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedSoftBrush}"
                                       Margin="11,0,0,8"/>

                            <Button Style="{StaticResource NavButton}" Tag="library" AutomationProperties.Name="Libreria"
                                    Command="{Binding NavigateCommand}" CommandParameter="library">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8F1;" FontFamily="{StaticResource IconFont}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="Libreria" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" Tag="updates" AutomationProperties.Name="Aggiornamenti"
                                    Command="{Binding NavigateCommand}" CommandParameter="updates">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="Aggiornamenti" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Border Grid.Column="2" Padding="7,1" CornerRadius="999"
                                            Background="{StaticResource AmberDimBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding UpdateCount, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding UpdateCount}" FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AmberBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" Tag="installed" AutomationProperties.Name="Scaricate"
                                    Command="{Binding NavigateCommand}" CommandParameter="installed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="Scaricate" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <Border Grid.Column="2" Padding="7,1" CornerRadius="999"
                                            Background="#284644"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding InstalledCount, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding InstalledCount}" FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TealBrush}"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavButton}" Tag="settings" AutomationProperties.Name="Impostazioni"
                                    Command="{Binding NavigateCommand}" CommandParameter="settings">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Grid.Column="1" Text="Impostazioni" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Grid>
                            </Button>

                            <Border Height="1" Margin="10,18,10,16" Background="{StaticResource LineSoftBrush}"/>

                            <TextBlock Text="FILTRI" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedSoftBrush}"
                                       Margin="11,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding Filters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SidebarFilterButton}" AutomationProperties.Name="{Binding Label}"
                                                Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Key}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                                         Fill="{Binding Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5"
                                                           VerticalAlignment="Center" Opacity="0.8"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0"
                            Padding="22,13">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource BtnSmall}"
                                        Content="{Binding AppUpdateButtonText}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        ToolTip="Scarica l'aggiornamento, sostituisce l'exe e riavvia PatchIT"
                                        AutomationProperties.Name="Aggiorna PatchIT"
                                        Command="{Binding DownloadAppUpdateCommand}"
                                        IsEnabled="{Binding CanDownloadAppUpdate}"/>
                                <DockPanel Margin="0,8,0,0"
                                           Visibility="{Binding IsAppUpdating, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Right" FontSize="10.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedSoftBrush}"
                                               Text="{Binding AppUpdateProgress, StringFormat={}{0:0}%}"/>
                                    <ProgressBar Value="{Binding AppUpdateProgress, Mode=OneWay}"
                                                 Maximum="100" Height="4" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Button Style="{StaticResource BtnGhost}"
                                        Content="Note della release"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="0,6,0,0" FontSize="11"
                                        Command="{Binding OpenUrlCommand}"
                                        CommandParameter="{Binding AppUpdateUrl}"/>
                            </StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" FontSize="11"
                                           Foreground="{StaticResource MutedSoftBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="PatchIT Desktop" FontSize="11"
                                           Foreground="{StaticResource MutedSoftBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========== Contenuto ========== -->
            <Grid Grid.Column="1">
                <!-- Vista libreria / aggiornamenti -->
                <Grid Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Intestazione -->
                    <Border Grid.Row="0" Padding="34,26,34,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LibraryTitle}" FontSize="30"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource DisplayFont}"/>
                                    <TextBlock Text="{Binding LibrarySubtitle}" FontSize="13"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                                    <Border Margin="0,8,0,0" Padding="8,3" CornerRadius="999"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource AmberDimBrush}"
                                            Visibility="{Binding HasCatalogNote, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding CatalogNote}" FontSize="11"
                                                   Foreground="{StaticResource AmberBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         Style="{StaticResource SearchBox}"
                                         Width="360" Height="42"
                                         VerticalAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <DockPanel Margin="0,18,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12.5">
                                        <Run Text="{Binding GameCount, Mode=OneWay}"/><Run Text=" risultati"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource BtnSmall}" Content="Aggiorna tutto"
                                            Margin="14,0,0,0" VerticalAlignment="Center"
                                            AutomationProperties.Name="Aggiorna tutto"
                                            Command="{Binding UpdateAllCommand}"
                                            Visibility="{Binding CanUpdateAll, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Ordina" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedSoftBrush}"
                                               Margin="0,0,10,0"/>
                                    <ItemsControl ItemsSource="{Binding SortOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SidebarFilterButton}"
                                                        Margin="0,0,4,0" Padding="10,5"
                                                        AutomationProperties.Name="{Binding Label}"
                                                        Command="{Binding DataContext.SetSortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Key}">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>

                            <!-- Coda "Aggiorna tutto" -->
                            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10"
                                    Background="{StaticResource SurfaceHiBrush}"
                                    Visibility="{Binding IsQueueRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}"
                                                Content="Ferma" Margin="12,0,0,0"
                                                AutomationProperties.Name="Ferma aggiornamento"
                                                Command="{Binding CancelDownloadCommand}"/>
                                        <TextBlock Text="{Binding QueueMessage}" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                    </DockPanel>
                                    <ProgressBar Margin="0,9,0,0" Maximum="100"
                                                 Value="{Binding QueueProgress, Mode=OneWay}"
                                                 Foreground="{StaticResource AmberBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Margin="0,18,0,0" Background="{StaticResource LineSoftBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Corpo -->
                    <Grid Grid.Row="1">
                        <!-- Loading -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="170" Height="5" Margin="0,0,0,14"/>
                            <TextBlock Text="Caricamento libreria…" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <!-- Errore -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center" Margin="0,0,0,14"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Riprova"
                                    HorizontalAlignment="Center" Command="{Binding LoadCommand}"/>
                        </StackPanel>

                        <!-- Nessun risultato -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Border Width="64" Height="64" CornerRadius="20"
                                    Background="{StaticResource SurfaceBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,18">
                                <TextBlock Text="⌕" FontSize="30" Foreground="{StaticResource MutedSoftBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding EmptyMessage}" Margin="0,6,0,0" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center"/>
                            <Button Style="{StaticResource BtnSmall}" Content="Azzera ricerca e filtri"
                                    HorizontalAlignment="Center" Margin="0,16,0,0"
                                    AutomationProperties.Name="Azzera ricerca e filtri"
                                    Command="{Binding ResetFiltersCommand}"
                                    Visibility="{Binding CanResetFilters, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Griglia -->
                        <ListBox ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                 Margin="34,24,22,26"
                                 Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"
                                 PreviewMouseLeftButtonUp="GamesList_PreviewMouseLeftButtonUp"
                                 PreviewMouseRightButtonDown="GamesList_PreviewMouseRightButtonDown"
                                 KeyDown="GamesList_KeyDown">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource LineBrush}"
                                             Foreground="{StaticResource TextBrush}">
                                    <MenuItem IsEnabled="{Binding SelectedGame.CanInstallInGame, FallbackValue=False}"
                                              Command="{Binding InstallInGameCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Installa nel gioco"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem IsEnabled="{Binding SelectedGame.CanVerify, FallbackValue=False}"
                                              Command="{Binding VerifyFileCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Verifica integrità"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Command="{Binding RevealFileCommand}"
                                              CommandParameter="{Binding SelectedGame.LocalFilePath}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Apri cartella"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem IsEnabled="{Binding SelectedGame.IsDownloaded, FallbackValue=False}"
                                              Command="{Binding RemoveInstalledCommand}"
                                              CommandParameter="{Binding SelectedGame}">
                                        <MenuItem.Header>
                                            <TextBlock Text="Elimina dal disco"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Copertina -->
                                        <Grid Height="124">
                                            <Border CornerRadius="12" Background="{StaticResource CoverFallbackBrush}">
                                                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" Opacity="0.12"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Margin="16"/>
                                            </Border>

                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>

                                            <Border CornerRadius="12" Background="{StaticResource CoverFadeBrush}"/>

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9"
                                                    Padding="8,3" CornerRadius="999"
                                                    Background="{Binding StatusDimBrush}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                                    Padding="8,3" CornerRadius="999"
                                                    Background="{StaticResource AmberDimBrush}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="AGGIORNA" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AmberBrush}"/>
                                            </Border>

                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"
                                                    Padding="8,3" CornerRadius="999"
                                                    Background="#E6284644"
                                                    Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="SCARICATA" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TealBrush}"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="9"
                                                    Padding="8,3" CornerRadius="999"
                                                    Background="#E6284644"
                                                    ToolTip="{Binding InstalledFolder}"
                                                    Visibility="{Binding IsInstalledInGame, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="NEL GIOCO" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TealBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Titolo e meta -->
                                        <TextBlock Text="{Binding Title}" Margin="4,10,4,0"
                                                   FontSize="14" FontWeight="SemiBold" LineHeight="18"
                                                   TextWrapping="Wrap" ClipToBounds="True"
                                                   Height="38"/>
                                        <DockPanel Margin="4,6,4,0">
                                            <TextBlock DockPanel.Dock="Right" FontSize="11"
                                                       Foreground="{StaticResource MutedSoftBrush}"
                                                       Text="{Binding UpdatedLabel}"
                                                       Visibility="{Binding HasUpdatedDate, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Version}"/>
                                        </DockPanel>
                                        <ProgressBar Height="3" Margin="4,8,4,0" Maximum="100"
                                                     Value="{Binding DownloadPercent, Mode=OneWay}"
                                                     Foreground="{StaticResource AmberBrush}"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- Vista impostazioni -->
                <views:SettingsView Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}"/>

                <!-- Avviso in basso (errori non bloccanti) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                        Padding="14,10" CornerRadius="10"
                        Background="{StaticResource SurfaceHiBrush}"
                        BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="OK"
                                Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DismissStatusCommand}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" TextWrapping="Wrap"
                                   MaxWidth="520" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Overlay dettaglio ==================== -->
        <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource ScrimBrush}"
                    MouseLeftButtonUp="Scrim_MouseLeftButtonUp"/>

            <Border MaxWidth="1120" MaxHeight="780" Margin="52"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="22">
                <Grid>
                    <views:GameDetail/>
                    <Button Style="{StaticResource CloseButton}" Content="✕"
                            AutomationProperties.Name="Chiudi"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                            Command="{Binding CloseDetailCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
