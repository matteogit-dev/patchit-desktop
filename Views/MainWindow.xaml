<Window x:Class="PatchIt.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PatchIt.Client.ViewModels"
        xmlns:views="clr-namespace:PatchIt.Client.Views"
        Title="PatchIT — Catalogo traduzioni"
        Width="1260" Height="800"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/PatchIT;component/Assets/logo.png"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="14"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Colonna sinistra: lista ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="16,14,16,12">
                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                        <Image DockPanel.Dock="Left" Source="/PatchIT;component/Assets/logo.png"
                               Width="28" Height="28" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PatchIT" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12.5">
                            <Run Text="{Binding GameCount, Mode=OneWay}"/><Run Text=" patch"/>
                        </TextBlock>
                    </DockPanel>

                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <WrapPanel Margin="0,11,0,0">
                        <Button Style="{StaticResource PillButton}" Tag="all"
                                Content="Tutti" Command="{Binding SetFilterCommand}" CommandParameter="all"/>
                        <Button Style="{StaticResource PillButton}" Tag="complete"
                                Content="Completate" Command="{Binding SetFilterCommand}" CommandParameter="complete"/>
                        <Button Style="{StaticResource PillButton}" Tag="progress"
                                Content="In corso" Command="{Binding SetFilterCommand}" CommandParameter="progress"/>
                        <Button Style="{StaticResource PillButton}" Tag="paused"
                                Content="In pausa" Command="{Binding SetFilterCommand}" CommandParameter="paused"/>
                        <Button Style="{StaticResource PillButton}" Tag="planned"
                                Content="Pianificate" Command="{Binding SetFilterCommand}" CommandParameter="planned"/>
                    </WrapPanel>

                    <!-- Badge aggiornamenti -->
                    <Border Margin="0,11,0,0" Padding="11,7" CornerRadius="8"
                            Background="{StaticResource AmberDimBrush}"
                            Visibility="{Binding UpdateCount, Converter={StaticResource CountToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="▲" Foreground="{StaticResource AmberBrush}"
                                       FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                <Run Text="{Binding UpdateCount, Mode=OneWay}"/>
                                <Run Text=" aggiornamento/i disponibili"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Corpo: caricamento / errore / lista -->
                <Grid Grid.Row="1">
                    <!-- Loading -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="150" Height="6" Margin="0,0,0,12"/>
                        <TextBlock Text="Caricamento catalogo…" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <!-- Errore -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="24"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Riprova"
                                HorizontalAlignment="Center"
                                Command="{Binding LoadCommand}"/>
                    </StackPanel>

                    <!-- Lista -->
                    <ListBox ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             Padding="12,4,12,16"
                             Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="88" Height="55"
                                            CornerRadius="7" ClipToBounds="True"
                                            Background="{StaticResource SurfaceHiBrush}">
                                        <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="11,1,0,1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Padding="7,2" CornerRadius="999"
                                                    Background="{Binding StatusDimBrush}">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="10.5"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                                    </Style>
                                                </Border.Resources>
                                                <TextBlock Text="{Binding StatusLabel}"/>
                                            </Border>

                                            <Border Margin="7,0,0,0" Padding="7,2" CornerRadius="999"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="10.5"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                    </Style>
                                                </Border.Resources>
                                                <TextBlock Text="AGGIORNA"/>
                                            </Border>

                                            <Border Margin="7,0,0,0" Padding="7,2" CornerRadius="999"
                                                    Background="{StaticResource SurfaceHiBrush}">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="10.5"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    </Style>
                                                </Border.Resources>
                                                <TextBlock Text="{Binding Version}"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5"
                                                   Margin="0,6,0,0"
                                                   Text="{Binding UpdatedLabel}"
                                                   Visibility="{Binding HasUpdatedDate, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- Separatore -->
        <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}"/>

        <!-- ============ Colonna destra: dettaglio ============ -->
        <views:GameDetail Grid.Column="2"/>
    </Grid>
</Window>
