<UserControl x:Class="PatchIt.Client.Views.GameDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <!-- Stato vuoto -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
            <TextBlock Text="Seleziona un titolo dalla libreria"
                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
        </StackPanel>

        <!-- Dettaglio -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- Copertina con titolo -->
                <Grid Height="300">
                    <Border Background="{StaticResource CoverFallbackBrush}"/>

                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding SelectedGame.CoverPath}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <Border Background="{StaticResource DetailFadeBrush}"/>

                    <StackPanel VerticalAlignment="Bottom" Margin="36,0,36,26">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Padding="10,4" CornerRadius="999"
                                    Background="{Binding SelectedGame.StatusDimBrush}">
                                <TextBlock Text="{Binding SelectedGame.StatusLabel}" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedGame.StatusBrush}"/>
                            </Border>

                            <Border Margin="8,0,0,0" Padding="10,4" CornerRadius="999"
                                    Background="{StaticResource ChipBrush}">
                                <TextBlock Text="{Binding SelectedGame.Version}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Border>

                            <Border Margin="8,0,0,0" Padding="10,4" CornerRadius="999"
                                    Background="{StaticResource AmberDimBrush}"
                                    Visibility="{Binding SelectedGame.HasUpdate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Aggiornamento disponibile" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedGame.Title}"
                                   FontSize="34" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}"
                                   TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="{Binding SelectedGame.UpdatedFull}"
                                       Visibility="{Binding SelectedGame.HasUpdatedDate, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="16,0,0,0"
                                       Visibility="{Binding SelectedGame.HasTags, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding SelectedGame.TagsLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Contenuto -->
                <StackPanel Margin="36,24,36,42">

                    <!-- Descrizione -->
                    <TextBlock FontSize="14.5" LineHeight="23" MaxWidth="860"
                               HorizontalAlignment="Left" Foreground="#C9CDD6"
                               Visibility="{Binding SelectedGame.HasDescription, Converter={StaticResource BoolToVis}}"
                               Text="{Binding SelectedGame.Description}"/>

                    <!-- Avanzamento traduzione -->
                    <StackPanel Margin="0,22,0,0" MaxWidth="860" HorizontalAlignment="Left"
                                Visibility="{Binding SelectedGame.ShowProgress, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                       Text="{Binding SelectedGame.ProgressLabel}"/>
                            <TextBlock Text="Avanzamento traduzione" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </DockPanel>
                        <ProgressBar Margin="0,9,0,0"
                                     Value="{Binding SelectedGame.ProgressValue, Mode=OneWay}"
                                     Maximum="100"/>
                    </StackPanel>

                    <!-- Azioni -->
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Style="{StaticResource BtnPrimary}"
                                MinWidth="200"
                                Command="{Binding DownloadCommand}"
                                IsEnabled="{Binding SelectedGame.DownloadEnabled}"
                                Content="{Binding SelectedGame.DownloadButtonText}"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Pagina Steam"
                                Margin="12,0,0,0"
                                Visibility="{Binding SelectedGame.HasSteam, Converter={StaticResource BoolToVis}}"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="{Binding SelectedGame.SteamUrl}"/>
                    </StackPanel>

                    <!-- Stato download -->
                    <StackPanel Margin="0,18,0,0" MaxWidth="860" HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DownloadMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}"
                                     Maximum="100"
                                     Foreground="{StaticResource AmberBrush}"/>
                        <TextBlock Margin="0,9,0,0" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding DownloadMessage}"/>
                    </StackPanel>

                    <!-- Cartella download -->
                    <DockPanel Margin="0,18,0,0" MaxWidth="860" HorizontalAlignment="Left">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}"
                                Content="Cambia cartella"
                                Command="{Binding ChangeFolderCommand}"/>
                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="0,0,16,0" TextTrimming="CharacterEllipsis">
                            <Run Text="Salva in "/><Run Text="{Binding DownloadDirectory, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>

                    <!-- Istruzioni + Changelog -->
                    <Grid Margin="0,34,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding SelectedGame.HasInstructions, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="COME INSTALLARE"/>
                            <ItemsControl ItemsSource="{Binding SelectedGame.Instructions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,13">
                                            <Border DockPanel.Dock="Left" Width="26" Height="26"
                                                    CornerRadius="999"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    BorderBrush="{StaticResource LineSoftBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,1,12,0">
                                                <TextBlock Text="{Binding Number}" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TealBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                                       FontSize="13.5" Foreground="#C9CDD6"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding SelectedGame.HasChangelog, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="CHANGELOG"/>
                            <ItemsControl ItemsSource="{Binding SelectedGame.Changelog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1"
                                                CornerRadius="10" Padding="14,11" Margin="0,0,0,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Background" Value="#152725"/>
                                                            <Setter Property="BorderBrush" Value="#2E5E5A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="11.5"
                                                               Foreground="{StaticResource MutedSoftBrush}"
                                                               Text="{Binding Date}"/>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AmberBrush}"
                                                               Text="{Binding Version}"/>
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0" FontSize="13.5"
                                                           Foreground="#C9CDD6"
                                                           Text="{Binding Note}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
