<UserControl x:Class="PatchIt.Client.Views.GameDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <Grid>
        <!-- Stato vuoto -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="↓" FontSize="24" Foreground="{StaticResource AmberBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Seleziona una traduzione dalla lista"
                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextAlignment="Center"
                       Text="Scarica la patch con un clic e leggi le istruzioni di installazione."/>
        </StackPanel>

        <!-- Dettaglio -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="30,26,34,44">

                <!-- Banner cover -->
                <Border Height="212" CornerRadius="12" ClipToBounds="True"
                        Background="{StaticResource SurfaceBrush}">
                    <Image Source="{Binding SelectedGame.CoverPath}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Titolo + pill -->
                <DockPanel Margin="0,20,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="10,5" CornerRadius="999"
                                Background="{Binding SelectedGame.StatusDimBrush}">
                            <TextBlock Text="{Binding SelectedGame.StatusLabel}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding SelectedGame.StatusBrush}"/>
                        </Border>
                        <Border Margin="9,0,0,0" Padding="10,5" CornerRadius="999"
                                Background="{StaticResource SurfaceHiBrush}">
                            <TextBlock Text="{Binding SelectedGame.Version}" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <Border Margin="9,0,0,0" Padding="10,5" CornerRadius="999"
                                Background="{StaticResource AmberDimBrush}"
                                Visibility="{Binding SelectedGame.HasUpdate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Aggiornamento disponibile" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AmberBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedGame.Title}"
                               FontSize="26" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}"/>
                </DockPanel>

                <!-- Meta -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="{Binding SelectedGame.UpdatedFull}"
                               Visibility="{Binding SelectedGame.HasUpdatedDate, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0"
                               Visibility="{Binding SelectedGame.HasTags, Converter={StaticResource BoolToVis}}"
                               Text="{Binding SelectedGame.TagsLabel}"/>
                </StackPanel>

                <!-- Descrizione -->
                <TextBlock Margin="0,16,0,0" FontSize="14.5" LineHeight="22"
                           Foreground="#C9CDD6"
                           Visibility="{Binding SelectedGame.HasDescription, Converter={StaticResource BoolToVis}}"
                           Text="{Binding SelectedGame.Description}"/>

                <!-- Progresso traduzione -->
                <StackPanel Margin="0,18,0,0"
                            Visibility="{Binding SelectedGame.ShowProgress, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource MutedText}" DockPanel.Dock="Right"
                                   Text="{Binding SelectedGame.ProgressLabel}"/>
                        <TextBlock Text="Avanzamento traduzione" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,0"
                                 Value="{Binding SelectedGame.ProgressValue, Mode=OneWay}"
                                 Maximum="100"/>
                </StackPanel>

                <!-- Azioni -->
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource BtnPrimary}"
                            MinWidth="180"
                            Command="{Binding DownloadCommand}"
                            IsEnabled="{Binding SelectedGame.DownloadEnabled}"
                            Content="{Binding SelectedGame.DownloadButtonText}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Pagina Steam"
                            Margin="12,0,0,0"
                            Visibility="{Binding SelectedGame.HasSteam, Converter={StaticResource BoolToVis}}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding SelectedGame.SteamUrl}"/>
                </StackPanel>

                <!-- Stato download -->
                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DownloadMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}"
                                 Maximum="100"
                                 Foreground="{StaticResource AmberBrush}"/>
                    <TextBlock Margin="0,8,0,0" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding DownloadMessage}"/>
                </StackPanel>

                <!-- Cartella download -->
                <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}"
                            Content="Cambia cartella"
                            Command="{Binding ChangeFolderCommand}"/>
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="Salva in:"/><Run Text="{Binding DownloadDirectory, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>

                <!-- Istruzioni -->
                <StackPanel Margin="0,30,0,0"
                            Visibility="{Binding SelectedGame.HasInstructions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeading}" Text="COME INSTALLARE"/>
                    <ItemsControl ItemsSource="{Binding SelectedGame.Instructions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,11">
                                    <Border DockPanel.Dock="Left" Width="24" Height="24"
                                            CornerRadius="999" Background="{StaticResource SurfaceHiBrush}"
                                            Margin="0,1,12,0">
                                        <TextBlock Text="{Binding Number}" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TealBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                               FontSize="14" Foreground="#C9CDD6"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Changelog -->
                <StackPanel Margin="0,26,0,0"
                            Visibility="{Binding SelectedGame.HasChangelog, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeading}" Text="CHANGELOG"/>
                    <ItemsControl ItemsSource="{Binding SelectedGame.Changelog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Entry"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10" Padding="14,11" Margin="0,0,0,9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Background" Value="#1A2E2C"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Date}"/>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AmberBrush}"
                                                       Text="{Binding Version}"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,5,0,0" FontSize="13.5"
                                                   Foreground="#C9CDD6"
                                                   Text="{Binding Note}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
