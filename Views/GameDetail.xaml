<UserControl x:Class="PatchIt.Client.Views.GameDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>
        <!-- Stato vuoto -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
            <TextBlock Text="Seleziona un titolo dalla libreria"
                       FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
        </StackPanel>

        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== Hero ========== -->
            <Grid Grid.Row="0" Height="210">
                <Border CornerRadius="21,21,0,0" Background="{StaticResource CoverFallbackBrush}"/>

                <Border CornerRadius="21,21,0,0" Opacity="0.25">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding SelectedGame.Cover}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <Border CornerRadius="21,21,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#F20B0D12" Offset="0"/>
                            <GradientStop Color="#B30B0D12" Offset="0.5"/>
                            <GradientStop Color="#590B0D12" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border CornerRadius="21,21,0,0" Background="{StaticResource DetailFadeBrush}"/>

                <Grid Margin="34,0,34,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,26,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <Border Padding="10,4" CornerRadius="999"
                                    Background="{Binding SelectedGame.StatusDimBrush}">
                                <TextBlock Text="{Binding SelectedGame.StatusLabel}" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedGame.StatusBrush}"/>
                            </Border>

                            <Border Margin="8,0,0,0" Padding="10,4" CornerRadius="999"
                                    Background="{StaticResource ChipBrush}"
                                    Visibility="{Binding SelectedGame.HasVersion, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedGame.Version}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </Border>

                            <Border Margin="8,0,0,0" Padding="10,4" CornerRadius="999"
                                    Background="{StaticResource AmberDimBrush}"
                                    Visibility="{Binding SelectedGame.HasUpdate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Aggiornamento disponibile" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedGame.Title}"
                                   FontSize="31" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}"
                                   TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="{Binding SelectedGame.UpdatedFull}"
                                       Visibility="{Binding SelectedGame.HasUpdatedDate, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="16,0,0,0"
                                       Visibility="{Binding SelectedGame.HasTags, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding SelectedGame.TagsLabel}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="232" Height="130" CornerRadius="12"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource SurfaceHiBrush}"
                            BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border CornerRadius="11">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding SelectedGame.Cover}"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== Corpo: contenuti + pannello azioni ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- Contenuti scrollabili -->
                <Grid Grid.Column="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedGame.HasDetailsContent, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="34,22,34,38">

                        <TextBlock FontSize="14.5" LineHeight="23" Foreground="#C9CDD6"
                                   Visibility="{Binding SelectedGame.HasDescription, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding SelectedGame.Description}"/>

                        <!-- Istruzioni -->
                        <StackPanel Margin="0,28,0,0"
                                    Visibility="{Binding SelectedGame.HasInstructions, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="COME INSTALLARE"/>
                            <ItemsControl ItemsSource="{Binding SelectedGame.Instructions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,13">
                                            <Border DockPanel.Dock="Left" Width="26" Height="26"
                                                    CornerRadius="999"
                                                    Background="{StaticResource SurfaceHiBrush}"
                                                    BorderBrush="{StaticResource LineSoftBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,1,12,0">
                                                <TextBlock Text="{Binding Number}" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TealBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                                       FontSize="13.5" Foreground="#C9CDD6"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Changelog -->
                        <StackPanel Margin="0,26,0,0"
                                    Visibility="{Binding SelectedGame.HasChangelog, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="CHANGELOG"/>
                            <ItemsControl ItemsSource="{Binding SelectedGame.Changelog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1"
                                                CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Background" Value="#152725"/>
                                                            <Setter Property="BorderBrush" Value="#2E5E5A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontSize="11.5"
                                                               Foreground="{StaticResource MutedSoftBrush}"
                                                               Text="{Binding Date}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AmberBrush}"
                                                                   Text="{Binding Version}"/>
                                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="999"
                                                                Background="{StaticResource AmberDimBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="NUOVA" FontSize="9.5" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AmberBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Margin="0,4,0,0" FontSize="13"
                                                           Foreground="#C9CDD6"
                                                           Text="{Binding Note}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40"
                                Visibility="{Binding SelectedGame.HasDetailsContent, Converter={StaticResource InvBoolToVis}}">
                        <Border Width="60" Height="60" CornerRadius="18"
                                Background="{StaticResource SurfaceHiBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="⌕" FontSize="26" Foreground="{StaticResource MutedSoftBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nessun dettaglio disponibile" FontSize="16" FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Questo titolo non ha ancora descrizione o istruzioni."
                                   FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Pannello azioni fisso -->
                <Border Grid.Column="1"
                        Background="#11151D"
                        BorderBrush="{StaticResource LineSoftBrush}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,0,21,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,20,22,24">

                            <TextBlock Style="{StaticResource SectionHeading}" Text="PATCH"/>

                            <Border Margin="0,0,0,14" Padding="11,8" CornerRadius="9"
                                    Background="{StaticResource AmberDimBrush}"
                                    Visibility="{Binding SelectedGame.HasUpdate, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Disponibile una nuova versione" FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}"/>
                            </Border>

                            <!-- Avanzamento traduzione -->
                            <StackPanel Margin="0,2,0,16"
                                        Visibility="{Binding SelectedGame.ShowProgress, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding SelectedGame.ProgressLabel}"/>
                                    <TextBlock Text="Avanzamento" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </DockPanel>
                                <ProgressBar Value="{Binding SelectedGame.ProgressValue, Mode=OneWay}"
                                             Maximum="100"/>
                            </StackPanel>

                            <Button Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DownloadCommand}"
                                    IsEnabled="{Binding SelectedGame.DownloadEnabled}"
                                    Content="{Binding SelectedGame.DownloadButtonText}"/>

                            <Button Style="{StaticResource BtnGhost}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Content="Pagina Steam"
                                    Visibility="{Binding SelectedGame.HasSteam, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding SelectedGame.SteamUrl}"/>

                            <!-- Stato download (per gioco) -->
                            <StackPanel Margin="0,15,0,0"
                                        Visibility="{Binding SelectedGame.ShowsDownloadStatus, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{Binding SelectedGame.DownloadPercent, Mode=OneWay}"
                                             Maximum="100"
                                             Foreground="{StaticResource AmberBrush}"/>
                                <TextBlock Margin="0,8,0,0" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding SelectedGame.DownloadMessage}"/>
                                <Button Style="{StaticResource BtnSmall}"
                                        Content="Annulla download"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        AutomationProperties.Name="Annulla download"
                                        Command="{Binding CancelDownloadCommand}"
                                        Visibility="{Binding SelectedGame.IsDownloading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Border Height="1" Margin="0,18,0,16" Background="{StaticResource LineSoftBrush}"/>

                            <TextBlock Style="{StaticResource SectionHeading}" Text="DETTAGLI"/>
                            <DockPanel Margin="0,0,0,9"
                                       Visibility="{Binding SelectedGame.HasVersion, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding SelectedGame.Version}"/>
                                <TextBlock Text="Versione" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9"
                                       Visibility="{Binding SelectedGame.HasInstalledDate, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" FontSize="12.5"
                                           Foreground="{StaticResource TealBrush}"
                                           Text="{Binding SelectedGame.InstalledDateLabel}"/>
                                <TextBlock Text="Installata" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9"
                                       Visibility="{Binding SelectedGame.HasUpdatedDate, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding SelectedGame.UpdatedLabel}"/>
                                <TextBlock Text="Aggiornata" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9"
                                       Visibility="{Binding SelectedGame.HasTags, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Right" FontSize="12.5" MaxWidth="170"
                                           TextAlignment="Right" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding SelectedGame.TagsLabel}"/>
                                <TextBlock Text="Categorie" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </DockPanel>

                            <Border Height="1" Margin="0,10,0,16" Background="{StaticResource LineSoftBrush}"/>

                            <TextBlock Style="{StaticResource SectionHeading}" Text="CARTELLA"/>
                            <TextBlock Text="{Binding SelectedGame.DownloadFolder}" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <TextBlock Text="Personalizzata per questo gioco" FontSize="11"
                                       Foreground="{StaticResource TealBrush}" Margin="0,0,0,8"
                                       Visibility="{Binding SelectedGame.HasCustomFolder, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource BtnSmall}"
                                    HorizontalAlignment="Stretch"
                                    Content="Cambia per questo gioco"
                                    AutomationProperties.Name="Cambia cartella per questo gioco"
                                    Command="{Binding ChangeGameFolderCommand}"
                                    CommandParameter="{Binding SelectedGame}"/>
                            <Button Style="{StaticResource BtnSmall}"
                                    HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                    Content="Usa cartella predefinita"
                                    AutomationProperties.Name="Usa la cartella predefinita"
                                    Command="{Binding ResetGameFolderCommand}"
                                    CommandParameter="{Binding SelectedGame}"
                                    Visibility="{Binding SelectedGame.HasCustomFolder, Converter={StaticResource BoolToVis}}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
